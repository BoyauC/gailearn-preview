{
  "name": "ch6-stoplight-class",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "emulators": "firebase emulators:start --project demo-stoplight-class",
    "seed:questions": "npm --prefix functions run seed:questions",
    "test": "npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-stoplight-class \"node --test test/firestore.rules.test.mjs\"",
    "test:integration": "firebase emulators:exec --only auth,firestore,functions --project demo-stoplight-class \"node --test functions/test/functions.integration.js\"",
    "deploy": "firebase deploy --only hosting,firestore,functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.24.0"
  }
}
