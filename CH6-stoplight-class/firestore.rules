rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function teacherMemberId(sessionId) {
      return sessionId + '_' + request.auth.uid;
    }

    function isTeacher(sessionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sessionMembers/$(teacherMemberId(sessionId)))
        && get(/databases/$(database)/documents/sessionMembers/$(teacherMemberId(sessionId))).data.role == 'teacher';
    }

    match /sessions/{sessionId} {
      allow read: if isTeacher(sessionId);
      allow write: if false;
    }

    match /sessionMembers/{memberId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isTeacher(resource.data.sessionId));
      allow write: if false;
    }

    match /sessionQuestions/{questionId} {
      allow read: if isTeacher(resource.data.sessionId);
      allow write: if false;
    }

    match /submissions/{submissionId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isTeacher(resource.data.sessionId));
      allow write: if false;
    }

    match /sessionSecrets/{sessionId} {
      allow read, write: if false;
    }

    match /activeCodes/{code} {
      allow read, write: if false;
    }

    match /questionBank/{questionId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
